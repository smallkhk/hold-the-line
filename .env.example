PORT=3070
# Free key: https://console.groq.com/keys
AI_KEY=
AI_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=openai/gpt-oss-120b
# low = faster, medium = smarter callers
AI_EFFORT=medium
# used automatically when the main model hits the free per-minute limit
AI_FALLBACK_MODEL=qwen/qwen3.8-27b
STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_MODEL=whisper-large-v3-turbo
# Natural voices. Accept terms once: https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
TTS_MODEL=canopylabs/orpheus-v1-english
RPM_PER_IP=60
